PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ai_reminder
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
ANTHROPIC_API_KEY=your_anthropic_api_key
# How often the reminder scheduler checks for due reminders (milliseconds).
SCHEDULER_INTERVAL_MS=60000

# --- Twilio (WhatsApp + AI voice call). Leave blank to disable those channels. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp sender, e.g. whatsapp:+14155238886 (Twilio sandbox number)
TWILIO_WHATSAPP_FROM=
# Voice caller ID, a Twilio phone number in E.164, e.g. +14155551234
TWILIO_VOICE_FROM=
# Public HTTPS base URL Twilio can reach for voice webhooks (e.g. an ngrok URL
# or your deployed domain). Required for AI phone calls.
PUBLIC_BASE_URL=

# --- Email channel. Two options — set EMAIL_FROM plus ONE of the two below. ---
# Preferred on hosts that block outbound SMTP ports (e.g. Render free tier):
# Brevo's free HTTP API (300 emails/day). Sign up at brevo.com, verify a
# single sender email (no domain needed), then get an API key from
# Settings > SMTP & API > API Keys.
BREVO_API_KEY=
# Fallback: raw SMTP (works locally; may be port-blocked on some hosts).
# For Gmail use host smtp.gmail.com, port 587, and a Google app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=AI Reminder <no-reply@example.com>

# Shared secret for machine-to-machine automation (e.g. n8n cron workflows).
AUTOMATION_API_KEY=

# --- Web Push (free). Generate with: npx web-push generate-vapid-keys ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Google Sign-In (free). Same Client ID as the frontend's
# VITE_GOOGLE_CLIENT_ID — from Google Cloud Console > APIs & Services >
# Credentials > OAuth client ID (type: Web application). ---
GOOGLE_CLIENT_ID=
